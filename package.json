{
  "name": "happy-cape-tours",
  "private": true,
  "scripts": {
    "build": "node scripts/sync-components.mjs && node scripts/build-app.mjs && tailwindcss -i assets/tailwind.css -o assets/tailwind.min.css --minify",
    "check": "node scripts/check-site.mjs",
    "test": "node scripts/build-app.mjs && node --test tests/*.test.mjs",
    "images": "node scripts/optimize-images.mjs",
    "start": "node dist/server.mjs",
    "dev": "npm run build && node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "check:local": "node scripts/check-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@hono/node-server": "^2.1.6",
    "@neon/config": "^1.10.1",
    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "^0.6.0-beta",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "apexcharts": "^8.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
