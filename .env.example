# Pull managed values with npx neon@latest env pull. Never put credentials in browser assets.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_FUNCTION_GALLERY_BASE_URL=
# Optional local browser API URL, if testing frontend against the local Node API:
# APP_API_URL=http://localhost:3000/api
PORT=3000
